{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aden-portfolio",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/_worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "replace-with-kv-namespace-id"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "aden-kb"
    }
  ],
  "ratelimits": [
    {
      "name": "ASK_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "aden_portfolio"
    }
  ]
}
