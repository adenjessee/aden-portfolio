# Copy to .env for `astro dev`. Nothing here is required: missing keys fall back to notes-only mode.
# In production set secrets with `npx wrangler secret put NAME`.

# Model. The first key present wins (Anthropic first) unless LLM_PROVIDER pins one: anthropic | openai | none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=
# Default claude-haiku-5-5 (fast; the avatar starts talking ~1.5s after Enter). claude-sonnet-5-5 answers with more
# judgment, a little slower, ~20x the model cost. Compare with `npm run evals -- --llm` before switching.
LLM_MODEL=
# Optional Cloudflare AI Gateway base URL (…/anthropic) for caching, logs and a spend view.
AI_GATEWAY_URL=

# Voice. With only the key set, the avatar speaks in "Will", an ElevenLabs premade voice.
# Set ELEVENLABS_VOICE_ID to your own clone once you have trained it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Reading messages left through AI Aden: `INBOX_TOKEN=... npm run inbox`. Use a long random string.
INBOX_TOKEN=

# Ceilings
DAILY_BUDGET_USD=5
SESSION_QUESTION_CAP=5
SESSION_VOICE_SECONDS=180

# Only for `npm run embed-kb` (Workers AI: Read + Vectorize: Edit)
CF_ACCOUNT_ID=
CF_API_TOKEN=
