# Copy to .env. Local `astro dev` works without any of these.
# Missing keys degrade to extractive RAG, text mode, and cached demo.

# LLM (optional). Model IDs live here, never hardcoded in adapters.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
AI_GATEWAY_URL=

# Voice (optional). Professional Voice Clone after you record 30+ minutes.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Cost ceilings
DAILY_BUDGET_USD=5
SESSION_QUESTION_CAP=5
SESSION_VOICE_SECONDS=180

# Cloudflare (set in the dashboard for production; local uses memory fallbacks)
# VECTORIZE_INDEX=aden-kb
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
