---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
import Stage from "../components/Stage.tsx";
---

<Base
  bare
  title={`Ask AI Aden · ${site.name}`}
  description="Talk to Aden's AI. It answers out loud from notes Aden wrote, and says so when he has not written something down."
  path="/ask"
>
  <main>
    <noscript>
      <div class="wrap section prose">
        <h1>Ask AI Aden</h1>
        <p>This page needs JavaScript to talk. Everything AI Aden can say is readable at <a href="/notes">/notes</a>, and the rest of the site works without it: <a href="/">home</a>, <a href="/resume">resume</a>.</p>
      </div>
    </noscript>
    <Stage client:load />
  </main>
</Base>
