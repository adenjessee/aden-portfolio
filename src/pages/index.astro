---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../config/site";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">Applied AI engineer · GridSchool founder</p>
          <h1>{site.name}</h1>
          <p class="lead">
            I build applied AI and agentic graph engineering systems: maps of how a codebase fits together, and agents that make changes a team can check before it trusts them.
          </p>
          <p class="lead">
            You can read the work below, or ask AI Aden. It answers from notes I wrote, cites them, and says so when I have not written something down.
          </p>
          <div class="actions">
            <a class="btn btn-solid" href="/ask">Ask AI Aden</a>
            <a class="btn" href="/resume">Resume</a>
            <a class="btn" href={site.github}>GitHub</a>
          </div>
          <noscript>
            <p class="noscript-note">JavaScript is off. The work below is complete. Everything AI Aden can say: <a href="/notes">the notes</a>.</p>
          </noscript>
        </div>
        <div class="poster">
          <img src={site.posterImage} alt="Stylized standing portrait of Aden Jessee" width="640" height="720" />
        </div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <p class="kicker">Work</p>
        <h2>Three things you can check</h2>
        <div class="cards">
          {projects.map((project) => (
            <article class="card">
              <p class="meta">{project.data.role}</p>
              <h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3>
              <p>{project.data.summary}</p>
              <div class="chips">
                {project.data.stack.map((item) => <span class="chip">{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="receipts">
      <div class="wrap">
        <p class="kicker">Receipts</p>
        <h2>URLs, not claims</h2>
        <div class="panel receipts">
          <div class="receipt">
            <span>GridSchool, live</span>
            <a href={site.gridschool}>{site.gridschool.replace("https://", "")}</a>
          </div>
          <div class="receipt">
            <span>GridSeak, source</span>
            <a href={site.gridseak}>github.com/adenjessee/gridseak</a>
          </div>
          <div class="receipt">
            <span>This site, source</span>
            <a href={`${site.github}/aden-portfolio`}>github.com/adenjessee/aden-portfolio</a>
          </div>
          <div class="receipt">
            <span>Every note AI Aden answers from</span>
            <a href="/notes">/notes</a>
          </div>
          <div class="receipt">
            <span>How AI Aden is tested</span>
            <a href="/evals">/evals</a>
          </div>
          <div class="receipt">
            <span>LinkedIn</span>
            <a href={site.linkedin}>linkedin.com/in/aden-jessee-4b3815189</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="method">
      <div class="wrap">
        <p class="kicker">How AI Aden works</p>
        <h2>An agent you can audit</h2>
        <div class="how-grid">
          <article class="card">
            <p class="how-step">01 · SCREEN</p>
            <p>Prompt injection and "say exactly…" requests are caught before any model runs. Free, deterministic, and covered by evals.</p>
          </article>
          <article class="card">
            <p class="how-step">02 · RETRIEVE</p>
            <p>BM25 and vector search over <a href="/notes">my published notes</a>, fused by rank. Every answer draws the map of what it found.</p>
          </article>
          <article class="card">
            <p class="how-step">03 · ANSWER</p>
            <p>Claude fills a fixed schema: speech, citations, a scene, one optional action. Citations it was not given are dropped. Citing nothing means "not on record."</p>
          </article>
          <article class="card">
            <p class="how-step">04 · ACT</p>
            <p>It can take a message for me, set up a call, or check a job description line by line, gaps included. The visitor confirms every action.</p>
          </article>
          <article class="card">
            <p class="how-step">05 · BOUND</p>
            <p>Five live questions a visit and a daily dollar ceiling. Past either, answers keep coming free from the notes. Each answer shows its cost.</p>
          </article>
          <article class="card">
            <p class="how-step">06 · TEST</p>
            <p><a href="/evals">Thirty-three eval cases</a> for grounding, refusals, injection, and hard rules. The free path runs them on every test run.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>
